# Copy to ~/.config/agent-tools/env and fill in. Every tool sources that file
# directly, so cron jobs and agent subprocesses get the values without
# depending on an interactive shell profile.
#
# Nothing in this repository may carry a real address: these name one operator's
# private network, and a tool that hardcodes them is a tool only that operator
# can run.
#
# A host is named for what it can do, never for what it is called. A project
# asks for a `builder`; whether that resolves to a rack server, a spare desktop
# or a cloud instance is nobody's business but yours. `HOST_<ROLE>` is the whole
# convention -- add a role by exporting one.
#
# The specs below are what each role was developed against, not a requirement.
# They are here so you can judge whether a machine you have is in the right
# class before finding out through a six-hour timeout.

# builder -- a capable server or workstation that runs tests, builds and other
# jobs on demand. Needs the project's toolchain, docker, and enough disk for a
# build cache that persists between runs.
#   Developed against: 8 vCPU, 32 GB RAM, 200 GB SSD, Linux.
#   Undersized shows up as a build cache thrashing rather than an outright
#   failure, so give it more disk than the source tree suggests.
export HOST_BUILDER=user@build-host

# A lane is an alternative builder, chosen per run with REMOTE_LANE; other roles
# ignore it. It is an environment variable so that it reaches remote-task through
# gate-verify and gate-prove. Give a lane its own LANE_POOL_<LANE> only when its
# memory is its own; otherwise it queues on the shared lock with every builder.
#   export HOST_BUILDER_FAST_LANE=user@fast-builder
#   export LANE_POOL_FAST_LANE=fast
#   REMOTE_LANE=fast-lane remote-task <tree>
#
# With BUILDER_LANES set, a run that names no lane takes the first idle one in
# order, and HOST_BUILDER serves only tools that take no lane. List the default
# builder as a lane to keep it in the rotation.
#   export BUILDER_LANES="fast-lane main"
#   export HOST_BUILDER_MAIN=user@build-host
#
# builder disk -- the guard that keeps a build from filling the disk.
#
# A builder that fills up mid-build fails as a linker bus error or an rsync
# ENOSPC, and it takes the database on the same disk with it. The check runs
# before the sync, so a build that would fill the disk never starts.
#
#   BUILDER_MIN_FREE_GB  the free space to insist on, in GB, AFTER the build.
#                        The default is 20. The check counts the tree being
#                        built and its `_prove` copy, because a cold gate for
#                        one branch is two trees of 35 GB.
#   BUILDER_TREE_GB      what one tree costs on this project, in GB.
#                        Default 35. It is the size of a warm tree, which is
#                        what a cold build has to write.
#   BUILDER_DB_CHECK     a command to run on the builder after the space is
#                        found, for a database that died on ENOSPC. It stays
#                        in restart backoff after the space comes back, and
#                        the next gate fails against it with "container is
#                        not running" -- which reads as a project failure
#                        rather than the infrastructure failure it is.
#                        Unset means no check.
#   REMOTE_PRUNE_IDLE_DAYS
#                        how old a tree's incremental cache must be before
#                        remote-prune will drop it. Default 3.
#export BUILDER_MIN_FREE_GB=20
#export BUILDER_TREE_GB=35
#export BUILDER_DB_CHECK="docker restart hypatia-ci-pg && pg_isready"
#export REMOTE_PRUNE_IDLE_DAYS=3

# cluster -- a machine holding the deployment toolchain: helm, terraform,
# kubectl and credentials for whatever they talk to. Usually small; it templates
# and validates, it does not compile.
#   Developed against: 4 vCPU, 8 GB RAM, Linux, no docker and no rsync -- which
#   is why the transport to this role is tar over ssh.
export HOST_CLUSTER=user@cluster-host

# An OpenAI-compatible chat-completions endpoint used to grade and route issues
# by size. The work is comparing short strings, so the smallest model you have
# is the right one; a large or metered model here buys nothing.
#   Developed against: a 20 GiB local model serving 64K context on a 32 GB box.
#   Context length is the constraint that matters -- grading reads issue text,
#   and a short window silently truncates the issues it is meant to compare.
export GRADER_URL=http://model-host:8080/v1/chat/completions

# Default repository for tools that take --repo, as owner/name. Falls back to
# the current checkout's origin remote when unset.
export DEFAULT_GH_REPO=owner/name

# A running tmux session where each hermes-implement lane opens a lane-watch
# window. Unset, or the session not running, means no window.
# export LANE_WATCH_TMUX_SESSION=watch

# lane identity -- the identity every lane commit must carry, read from
# these two variables alone.
#
# A lane dispatched by hermes-implement refuses to start unless both are set
# and non-empty, and it commits with this identity whatever the host's git
# config says. Nothing here is inferred from the machine: a host whose git
# config is wrong would otherwise pin every lane to that identity and pass
# its own check.
#export LANE_GIT_NAME="Lane Name"
#export LANE_GIT_EMAIL=lane@example.invalid

# review -- hermes-review-pr, hermes-review-sweep and the review skill's script.
#
#   REVIEW_WT_ROOT    where hermes-review-pr keeps its review/pr-N-PROFILE
#                     worktrees. The profile is part of the name, so two
#                     profiles can review the same PR at the same time from
#                     one clone; set one root per profile to keep their
#                     worktrees apart as well.
#   REVIEW_PRIORS     a file folded into every review prompt: the project's
#                     standing domain facts, so no run rediscovers them.
#   REVIEW_PROFILE    the reviewer when --profile is absent. Pick a model
#                     family different from the one that wrote the code.

#   REVIEW_HAZARDS    the file the execute phase reads as the repository's
#                     own hazard notes: what this codebase has shipped wrong
#                     before. Unset, and the phase takes AGENTS.md, then
#                     CLAUDE.md, then CONTRIBUTING.md, from the tree under
#                     review; a repository with none gets a note saying so.
#
# Per profile, <PROFILE> through env_name (uppercase, hyphens to underscores):
#
#   REVIEW_SLOTS_<PROFILE>    reviews that may run at once. Default 1, which
#                             fits a local model server with one slot.
#   REVIEW_TIMEOUT_<PROFILE>  seconds per review. --timeout overrides it, and
#                             without it HERMES_REVIEW_TIMEOUT applies, then 900.
#   GPU_GROUP_<PROFILE>       the GPU group that a profile's hermes holds while
#                             it runs, named for the host. Profiles sharing a
#                             group serialise on the group's lock; profiles on
#                             different groups run together. Empty profile
#                             resolves to GPU_GROUP_DEFAULT. Unset means no GPU
#                             group, no lock taken.
#
# github -- the loop's two identities. The reviewer is the repository's owner
# and the implementer authors the pull request, so a verdict can be a real
# review state rather than prose in a body.
#
# The implementer's credentials stay on the host it runs on. Nothing is
# carried to another host.
#
#   GH_IMPLEMENTER_TOKEN     a token for the implementer. Read by
#                            `gh_as implementer` for one call, in the
#                            environment and never on a command line. Unset
#                            means the host's own gh login is used.
#   GH_IMPLEMENTER_CONFIG_DIR the gh config directory holding the
#                            implementer's login, for a host whose
#                            implementer is not its default account.
#   IMPLEMENTER_LOGINS       the logins the implementer role may act as,
#                            space separated. `gh_as implementer` resolves
#                            the login the call would act as and refuses
#                            unless it is one of these, naming both. With
#                            none set, no call is allowed through.
#
# A role with no credentials at all is refused, naming the variable to set,
# rather than running as whoever the ambient gh auth happens to be.
#
# No model run gets any of these. A lane dispatched by hermes-implement runs
# with gh pointed at an empty config directory, so an accidental gh call
# fails. The lane runs as the same operating-system user as the dispatcher,
# so credentials that user can reach are still on the host; the empty config
# makes an accidental call fail, it does not make them unreadable.
#export REVIEW_WT_ROOT=/path/to/review-worktrees
#export REVIEW_PRIORS=/path/to/review-priors.txt
#export REVIEW_PROFILE=reviewer
#export REVIEW_HAZARDS=/path/to/review-hazards.md
#export REVIEW_SLOTS_REVIEWER=3
#export REVIEW_TIMEOUT_REVIEWER=1800
#export GPU_GROUP_DEFAULT=logan-3090
#export GPU_GROUP_MUSE1M=logan-3090
#export GH_IMPLEMENTER_CONFIG_DIR=$HOME/.config/gh
#export IMPLEMENTER_LOGINS=harbord-st

# bake-off -- the metering proxy, one port per harness.
#
#   BAKEOFF_PROVIDER_ENV  the file holding the provider's key, read by
#                         `bakeoff-proxy` for the key it sends. The
#                         variable it reads is MINIMAX_API_KEY unless
#                         `--key-var` names another.
#export BAKEOFF_PROVIDER_ENV=~/.config/bakeoff/provider.env
