# Copy to ~/.config/agent-tools/lanes.toml and fill in. The tool reads it
# from there, or from $LANE_CONFIG, and refuses a key it cannot act on.
# Every value here is a placeholder.
#
# Every harness's launch must fill {session}: the id names the harness's
# conversation, and a lane started without one can never be resumed.

tmux_session = "0"          # tmux target session
worktree_root = "~/wt"      # default worktree: <root>/<repo name>-<issue>
ready_seconds = 8           # wait after starting a harness, before it is used

# The keeper owns the lane record; this tool reads and changes it there.
#
# The token file holds the token alone, and its mode is checked: a token
# any other user can read is a token any lane can use.
[keeper]
url = "http://127.0.0.1:8787"
token_file = "~/.config/agent-tools/lane-token"

# The host the side effects happen on: the windows, the worktrees and the
# processes are there, and this host only asks for them over ssh.
[agent]
ssh = "hermesagent"

# A pool is a cap; a profile's cost is what it takes from its pool.
[pools]
minimax = 4
logan = 2

[profiles.minimax]
pool = "minimax"
cost = 1
model = "MiniMax"           # regex the pane footer must match; else `fallback`

[profiles.flashnext512]
pool = "logan"
cost = 2
model = "flash-next-512k"

[harnesses.hermes]
# The session id names the harness's conversation: `--continue <name>`
# creates it the first time and resumes it after. `--create-if-missing`
# belongs to `hermes chat`.
launch = "~/.local/bin/hermes chat -p {profile} --continue {session} --create-if-missing"

[harnesses.pi]
# The launcher's first argument is the session id, which it passes to
# `pi --session-id`.
launch = "~/pi-lane/pi-lane.sh {session} {profile}"

[repos."stickythistle/tooling"]
clone = "~/tooling-fixpr"
