#!/usr/bin/env bash
# Run the gates that can see what a branch actually changed.
#
# Choosing the gate by hand is where this goes wrong. A Helm template reached
# main because a Rust bench approved it; a misplaced `--no-build` reached CI
# because a compose check ran its own spelling of the command. Both times the
# gate was green and blind. Deriving the gate list from the diff removes the
# choice.
#
# Runs every applicable gate rather than stopping at the first failure, so one
# run reports everything wrong with the branch.
#
# The gates themselves live in the project's gates.toml. This decides which of
# them the diff has earned, runs them, and reports. --all runs every gate
# whatever the diff, which is how main gets a verdict of its own.
set -euo pipefail

# readlink -f, not `cd -P`: these are installed as symlinks into a bin
# directory on PATH, and BASH_SOURCE holds the symlink's own path. `cd -P`
# resolves symlinks inside the path it is given, not the script's location, so
# ../lib resolved against the link and landed outside the checkout.
LIB=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib" && pwd)
# shellcheck source=../lib/common.sh
. "$LIB/common.sh"

BASE=${VERIFY_BASE:-origin/main}
# Exported, not just read: the gates below are separate processes that each
# diff the branch themselves, and a gate reverting against a different base than
# the one that selected it is wrong in a way neither of them can see.
export VERIFY_BASE=$BASE

usage() { echo "usage: gate-verify <worktree> [--all] [--skip NAME]... [--list]" >&2; exit 2; }
[ $# -ge 1 ] || usage
SRC=$(repo_root "$1")
shift
LIST=0 SKIP=() ALL=0
while [ $# -gt 0 ]; do
	case "$1" in
	--skip) [ $# -ge 2 ] || usage; SKIP+=("$2"); shift 2 ;;
	--list) LIST=1; shift ;;
	--all) ALL=1; shift ;;
	*) usage ;;
	esac
done

cd "$SRC"
mapfile -t CHANGED < <(git diff --name-only "$BASE"...HEAD)
if [ "$ALL" -eq 0 ] && [ ${#CHANGED[@]} -eq 0 ]; then
	echo "no changes against $BASE" >&2
	exit 2
fi

# Warn, do not block: gating an unsettled tree is sometimes correct, and the
# gate's job is to exercise what the tree contains, not to police how it got
# there. A line of output here is enough -- a caller about to trust a tree
# deserves to know it moved (or that the lane that wrote it is still going)
# before the gates report. See issue #25.
BIN=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
set +e
"$BIN/lane-settled" "$SRC"
settled_rc=$?
set -e
# lane-settled has already printed which of the two it found, and exit 1 covers
# both a live lane and one that died holding the tree. Naming either here would
# put a second, less accurate account of the same fact on the same stream.
[ "$settled_rc" -eq 0 ] ||
	echo "WARNING: the worktree above is not settled; gating anyway" >&2

output=$(manifest "$SRC" gates)
eval "$output"

# Documentation and repository metadata; every other path counts as code.
# This asks whether a diff can go ungated, which is a different question
# from the coverage walk's SOURCE_EXTS (does a directory ship source).
is_documentation() {
	case "${1##*/}" in
	README|LICENSE|LICENSE.*|LICENCE|LICENCE.*|COPYING|NOTICE|CHANGELOG|AUTHORS|.editorconfig|.gitignore|.gitattributes) return 0 ;;
	esac
	case "$1" in
	*.md|*.rst) return 0 ;;
	*) return 1 ;;
	esac
}

DOCS=() CODE=()
for p in "${CHANGED[@]}"; do
	if is_documentation "$p"; then
		DOCS+=("$p")
	else
		CODE+=("$p")
	fi
done

skipped() {
	local n
	for n in ${SKIP[@]+"${SKIP[@]}"}; do [ "$n" = "$1" ] && return 0; done
	return 1
}

NAMES=() GATES=() SHOWN=()
# Only a gate with a `when` says what it covers.
NAMING=0
for i in "${!GATE_NAMES[@]}"; do
	name=${GATE_NAMES[$i]} when=${GATE_WHEN[$i]}
	skipped "$name" && continue
	# An empty `when` is a gate with no precondition -- cheap and
	# language-independent, so it runs on every branch.
	if [ "$ALL" -eq 0 ] && [ -n "$when" ] \
		&& ! printf '%s\n' "${CHANGED[@]}" | grep -qE "$when"; then
		continue
	fi
	NAMES+=("$name")
	SHOWN+=("${GATE_RUN[$i]}")
	# $REPO is what a manifest's `run` interpolates; exported so a gate that
	# shells out again still sees it.
	GATES+=("REPO=$(printf '%q' "$SRC") ; ${GATE_RUN[$i]}")
	[ -n "$when" ] && NAMING=$((NAMING + 1))
done

if [ ${#GATES[@]} -eq 0 ] && [ "$ALL" -eq 0 ] && [ ${#CODE[@]} -eq 0 ]; then
	echo "nothing to gate:" >&2
	printf '  %s\n' "${DOCS[@]}" >&2
	exit 0
fi

# Named: only the code, so a licence beside an unwired script is not blamed.
# An always-on gate names no path, so it cannot answer this.
if [ "$NAMING" -eq 0 ] && [ "$ALL" -eq 0 ] && [ ${#CODE[@]} -gt 0 ]; then
	echo "no gate matches:" >&2
	printf '  %s\n' "${CODE[@]}" >&2
	echo "Add one to gates.toml rather than shipping unverified." >&2
	exit 1
fi

if [ "$ALL" -eq 1 ]; then
	printf '==> --all: running every gate (%d file(s) changed)\n\n' "${#CHANGED[@]}"
else
	printf '==> %d file(s) changed; running: %s\n\n' "${#CHANGED[@]}" "$(IFS=, ; echo "${NAMES[*]}")"
fi

if [ "$LIST" = 1 ]; then
	# SHOWN, not GATE_RUN: the latter is every gate in the manifest, and indexing
	# it by a position in the selected list pairs a name with another gate's
	# command whenever anything was filtered out.
	for i in "${!GATES[@]}"; do printf '  %-18s %s\n' "${NAMES[$i]}" "${SHOWN[$i]}"; done
	exit 0
fi

failed=() unprovable=()
for i in "${!GATES[@]}"; do
	echo "########## ${NAMES[$i]} ##########"
	set +e
	eval "${GATES[$i]}"
	rc=$?
	set -e
	# 3 is a gate saying it could not answer, which is neither a pass nor a
	# failure. Reported on its own line so it cannot be read as either: a gate
	# that gathered no evidence must not appear in a list headed "passed".
	if [ $rc -eq 3 ]; then
		unprovable+=("${NAMES[$i]}")
	elif [ $rc -ne 0 ]; then
		failed+=("${NAMES[$i]}")
	fi
	echo
done

if [ ${#failed[@]} -gt 0 ]; then
	printf '==> FAILED: %s\n' "$(IFS=, ; echo "${failed[*]}")" >&2
	[ ${#unprovable[@]} -gt 0 ] && printf '==> UNPROVABLE: %s\n' "$(IFS=, ; echo "${unprovable[*]}")" >&2
	exit 1
fi
if [ ${#unprovable[@]} -gt 0 ]; then
	printf '==> UNPROVABLE: %s\n' "$(IFS=, ; echo "${unprovable[*]}")" >&2
	passed=()
	for n in "${NAMES[@]}"; do
		skip=0
		for u in "${unprovable[@]}"; do [ "$n" = "$u" ] && skip=1; done
		[ $skip -eq 0 ] && passed+=("$n")
	done
	[ ${#passed[@]} -gt 0 ] && echo "==> gates passed: $(IFS=, ; echo "${passed[*]}")"
	exit 0
fi
echo "==> all gates passed: $(IFS=, ; echo "${NAMES[*]}")"
