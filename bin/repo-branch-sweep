#!/usr/bin/env bash
# Report branches and worktrees whose work is already on the trunk.
#
# `git branch --merged` answers the wrong question here: a rebase- or
# squash-merge rewrites the commits, so a branch whose work is fully landed
# shares no commit with the trunk and reports as unmerged forever. Subjects
# survive that rewrite, so subjects are what this matches on.
#
# Reports by default. --prune deletes only what it could prove: local branch,
# its worktree, and the remote branch behind it.
set -euo pipefail

REPO=${1:-$PWD}
PRUNE=0
[[ "${2:-}" == "--prune" || "${1:-}" == "--prune" ]] && PRUNE=1
[[ "${1:-}" == "--prune" ]] && REPO=$PWD

cd "$REPO"
git fetch --prune --quiet origin

TRUNK=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/main)
SUBJECTS=$(mktemp)
git log --format=%s "$TRUNK" -500 >"$SUBJECTS"
trap 'rm -f "$SUBJECTS"' EXIT

landed=() unlanded=() empty=()
while read -r branch; do
	[[ -z "$branch" ]] && continue
	[[ "$branch" == "$(basename "$TRUNK")" ]] && continue

	# Commits the branch has that the trunk does not, by SHA. A branch whose
	# every subject is already on the trunk has landed, however it was merged.
	mapfile -t subjects < <(git log --format=%s "$TRUNK..$branch" 2>/dev/null)
	if [[ ${#subjects[@]} -eq 0 ]]; then
		# A lane's branch sits here between `worktree add` and its first
		# commit. It has landed nowhere; it has not started.
		empty+=("$branch (no commits of its own)")
		continue
	fi

	missing=0
	for subject in "${subjects[@]}"; do
		grep -qxF "$subject" "$SUBJECTS" || missing=$((missing + 1))
	done
	if [[ "$missing" -eq 0 ]]; then
		landed+=("$branch (${#subjects[@]} commit(s), all on $TRUNK by subject)")
	else
		unlanded+=("$branch (${#subjects[@]} commit(s), $missing not on $TRUNK)")
	fi
done < <(git for-each-ref --format='%(refname:short)' refs/heads/)

echo "== landed, safe to delete =="
printf '%s\n' "${landed[@]:-(none)}"
echo
echo "== still carrying work =="
printf '%s\n' "${unlanded[@]:-(none)}"
echo
# A branch with no commit of its own is not landed: it is a lane that has
# not pushed yet, and deleting it deletes that lane's work.
echo "== empty, no commits of its own =="
printf '%s\n' "${empty[@]:-(none)}"

# A worktree whose branch is gone leaves an administrative file behind, which is
# what makes `git worktree add` refuse a path that looks free.
echo
echo "== worktrees =="
git worktree list

if [[ "$PRUNE" -eq 1 && ${#landed[@]} -gt 0 ]]; then
	echo
	for entry in "${landed[@]}"; do
		branch=${entry%% *}
		wt=$(git worktree list --porcelain | awk -v b="refs/heads/$branch" '
			/^worktree /{path=$2} /^branch /{if ($2==b) print path}')
		if [[ -n "$wt" ]]; then
			# A dirty worktree is a lane still working, so it is skipped and
			# named rather than deleted. `git worktree remove` without
			# --force refuses it too; the check is here to say which.
			if [[ -n "$(git -C "$wt" status --porcelain)" ]]; then
				echo "skipped $branch: worktree $wt has uncommitted changes"
				continue
			fi
			git worktree remove "$wt" || {
				echo "skipped $branch: worktree $wt could not be removed" >&2
				continue
			}
		fi
		git branch -D "$branch"
		git push --quiet origin --delete "$branch" 2>/dev/null && echo "deleted origin/$branch" || true
	done
	git worktree prune
fi
