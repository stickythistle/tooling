#!/usr/bin/env python3
"""Attribute a stack's findings to the pull request that wrote each quote.

Reads the findings after finding-check located their quotes, and the plan
`stack-plan` printed before the review ran. The plan is an input: a PR
opened, closed or retargeted during the review cannot make this attribute
over a different stack than the one reviewed.

Each finding's located line is blamed at the reviewed head, and the blamed
commit is charged to the PR whose `base..head` range holds it. The output:

    {
      "stack": [ {"number": 1, "head": "feat/a", "title": "..."}, ... ],
      "findings": [
        {"path": "src/x.rs", "line": 11, "pr": 1, "reason": "attributed",
         "blamed_commit": "<sha>"},
        {"path": "src/y.rs", "line": 7, "pr": null, "reason": "stack"},
        {"path": "src/z.rs", "line": 2, "pr": null, "reason": "unlocated",
         "detail": "the quoted code was not located (...)"}
      ],
      "tally": {"attributed": 1, "stack": 1, "unlocated": 1}
    }

`reason` is `attributed` (the named PR wrote the quoted line), `stack` (the
line was written before the stack began, so no single PR of it can be
fixed for the finding), or `unlocated` (the quote was not located; it is
charged to nobody).
"""
from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

import stack_attrib  # noqa: E402


def stack_from_plan(plan: dict) -> list[stack_attrib.PullRequest]:
    """The plan's stack, bottom first."""
    try:
        stack = [
            stack_attrib.PullRequest(
                number=entry["number"],
                head_ref=entry["head"],
                base_ref=entry["base"],
                title=entry.get("title", ""),
            )
            for entry in plan["stack"]
        ]
    except (KeyError, TypeError) as exc:
        raise stack_attrib.StackError(
            f"the plan is not a stack-plan document: missing {exc}"
        ) from exc
    if not stack:
        raise stack_attrib.StackError("the plan holds no pull requests")
    return stack


def resolve_ref(repo_path: str, branch: str) -> str:
    """The local ref a remote branch is at.

    The review fetched the stack's branches as `origin/<branch>`; a local
    branch of the same name may be stale, so only the remote ref resolves.
    A branch with no remote ref is refused: attributing against a branch
    behind the remote would name the wrong pull request.
    """
    for candidate in (f"origin/{branch}", f"refs/remotes/origin/{branch}"):
        result = subprocess.run(
            ["git", "-C", repo_path, "rev-parse", "--verify",
             "--quiet", candidate],
            capture_output=True, text=True, check=False,
        )
        if result.returncode == 0 and result.stdout.strip():
            return candidate
    raise stack_attrib.StackError(
        f"branch {branch!r} is not fetched in {repo_path}; the review cannot "
        f"attribute a finding to a pull request whose branch is missing"
    )


def attribute_findings(repo_path: str, located: list,
                       stack: list[stack_attrib.PullRequest],
                       final_tree: str) -> dict:
    """Charge every located finding to the PR whose range holds its blame."""
    members = [
        (pr.number,
         resolve_ref(repo_path, pr.base_ref),
         resolve_ref(repo_path, pr.head_ref))
        for pr in stack
    ]
    blamer = stack_attrib.Blamer(repo_path, final_tree)
    findings = [
        stack_attrib.attribute_finding(f, repo_path, members, blamer)
        for f in located
    ]
    tally = {s: 0 for s in stack_attrib.STATUSES}
    for finding in findings:
        tally[finding["reason"]] += 1

    return {
        "stack": [
            {"number": pr.number, "head": pr.head_ref, "base": pr.base_ref,
             "title": pr.title}
            for pr in stack
        ],
        "findings": findings,
        "tally": tally,
    }


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Attribute a stack's review findings to its pull requests."
    )
    parser.add_argument("--plan", required=True,
                        help="the plan file stack-plan printed for this review")
    parser.add_argument("--repo-path", required=True,
                        help="the local checkout the review ran against")
    parser.add_argument("--located", required=True,
                        help="finding-check's annotated findings file")
    args = parser.parse_args()

    try:
        plan = json.loads(Path(args.plan).read_text())
        if not isinstance(plan, dict):
            raise stack_attrib.StackError(
                "the plan is not a stack-plan document"
            )
        stack = stack_from_plan(plan)
        floor = plan.get("default_branch")
        if not floor:
            raise stack_attrib.StackError(
                "the plan is not a stack-plan document: no default_branch"
            )
        stack_attrib.stack_floor(stack, floor)
        located = json.loads(Path(args.located).read_text())
        if not isinstance(located, list):
            raise stack_attrib.StackError(
                "the located findings are not a JSON array"
            )
        # The reviewed tree is the top of the stack, as the local ref it was
        # fetched to.
        final_tree = resolve_ref(args.repo_path, stack[-1].head_ref)
        result = attribute_findings(
            args.repo_path, located, stack, final_tree,
        )
    except stack_attrib.StackError as exc:
        sys.stderr.write(f"stack-attrib: {exc}\n")
        return 2
    except (OSError, json.JSONDecodeError) as exc:
        sys.stderr.write(f"stack-attrib: {exc}\n")
        return 2

    json.dump(result, sys.stdout, indent=2)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
