#!/usr/bin/env bash
# Review one open pull request with Hermes and park the findings on their own branch.
#
# The findings branch is never pushed: REVIEW_NOTES.md on a release branch would
# be a defect of its own. The diff is against the PR's own base, since diffing a
# stacked PR against main charges it with its parent's changes.
set -euo pipefail

# readlink -f: installed as a symlink on PATH, and lib/ sits beside the real file.
LIB=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib" && pwd)
# shellcheck source=../lib/common.sh
. "$LIB/common.sh"

BIN_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
SCRUTINIZE="$BIN_DIR/../skills/hermes-review/scripts/hermes-scrutinize.sh"

HERMES=${HERMES_PYTHON:-${HERMES_HOME:-$HOME/.hermes}/hermes-agent/venv/bin/python}
PR=""
PHASE=review
ANSWERS=""
REQUESTED_PROFILE=""
TIMEOUT_PASSED=""
TIMEOUT_OPT=""
STACK=0

usage() {
	cat <<'EOF'
usage: hermes-review-pr --pr N [--phase readback|review] [--answers FILE]
                        [--profile NAME] [--timeout SECONDS] [--stack]

readback  Ask what it thinks the scope is, what it will check, what it treats as
          out of scope, and what it cannot settle alone. Writes READBACK.md and
          stops. Correct the brief from this before spending the review.
review    Do the review. --answers FILE is folded into the prompt above the
          standing priors, so a decision made once does not have to be
          rediscovered.

--stack   Review the top of the PR's stack against the default branch, once,
          and attribute each finding to the PR whose diff introduced the line
          it cites; a line no PR changed belongs to the stack as a whole.
          The stack is found from the PR's own base, and naming any PR of it
          reviews the top. Writes REVIEW_NOTES.md and STACK_ATTRIBUTION.json.

Both phases write to $REVIEW_WT_ROOT/review-pr-N-PROFILE, on the branch
review/pr-N-PROFILE, branched from the PR head. Nothing is pushed.

The branch and the worktree name the profile, so two profiles can review the
same PR at the same time from one clone -- which is how two reviewers'
findings are compared. A profile name must match
^[A-Za-z0-9][A-Za-z0-9_-]*$, or the run stops.

REVIEW_WT_ROOT, REVIEW_PRIORS and REVIEW_PROFILE must be set in the operator's
env file. See hosts.env.example.
EOF
}

while [[ $# -gt 0 ]]; do
	case "$1" in
	--pr) PR="$2"; shift 2 ;;
	--phase) PHASE="$2"; shift 2 ;;
	--answers) ANSWERS="$2"; shift 2 ;;
	--profile) REQUESTED_PROFILE="$2"; shift 2 ;;
	--timeout) TIMEOUT_PASSED=1; TIMEOUT_OPT="$2"; shift 2 ;;
	--stack) STACK=1; shift ;;
	-h | --help) usage; exit 0 ;;
	*) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
	esac
done

case "$PHASE" in
readback | review) ;;
*) echo "--phase must be readback or review" >&2; exit 2 ;;
esac

# The readback phase briefs the reviewer on one PR's diff. In stack mode the
# review is of the whole stack, so a readback would brief it on the wrong
# thing: the brief has to name the combined tree.
if [[ "$STACK" == 1 && "$PHASE" == readback ]]; then
	echo "--stack applies to the review phase; a stack is reviewed as one change" >&2
	exit 2
fi


[[ -n "$PR" ]] || { echo "--pr is required" >&2; usage >&2; exit 2; }

require_env() {
	local var="$1" hint="$2"
	if [ -z "${!var:-}" ]; then
		echo "set $var to $hint (see hosts.env.example)" >&2
		exit 2
	fi
}

# Never an ambient PROFILE: that name is too generic to trust from an
# operator's environment, and it would send the review to the wrong host.
if [ -n "$REQUESTED_PROFILE" ]; then
	PROFILE="$REQUESTED_PROFILE"
else
	require_env REVIEW_PROFILE "the default Hermes profile (e.g. minimax)"
	PROFILE="$REVIEW_PROFILE"
fi

# The profile goes into a branch, a worktree path and a lock file, so it
# has to be one component of a path and of a git ref at once. Any other
# name is refused here, by name.
if ! profile_name_ok "$PROFILE"; then
	echo "profile name '$PROFILE' must match ^[A-Za-z0-9][A-Za-z0-9_-]*\$" >&2
	exit 2
fi

require_env REVIEW_WT_ROOT "the directory review worktrees live under"
WT_ROOT="$REVIEW_WT_ROOT"

require_env REVIEW_PRIORS "the priors file path"
PRIORS="$REVIEW_PRIORS"
[[ -r "$PRIORS" ]] || { echo "priors file not readable: $PRIORS" >&2; exit 2; }

[[ -x "$SCRUTINIZE" ]] || { echo "scrutinize script not executable: $SCRUTINIZE" >&2; exit 2; }

REPO_DIR=$(git rev-parse --show-toplevel)
cd "$REPO_DIR"

TIMEOUT=$(review_timeout_for "$PROFILE" "$TIMEOUT_OPT")

# A sweep starts every PR at once, and concurrent fetches into one repository
# fail on ref locks, so only the fetch and worktree setup are serialised. Fd 8,
# because fd 9 is the review slot.
SETUP_LOCK_DIR=$(git rev-parse --git-common-dir)
SETUP_LOCK="$SETUP_LOCK_DIR/hermes-review-setup.lock"
exec 8>"$SETUP_LOCK"
if ! flock 8; then
	echo "could not acquire $SETUP_LOCK" >&2
	exit 1
fi

# origin can be an SSH alias (git@<alias>:owner/name.git) which gh cannot
# resolve as a --repo value; only the owner/name tail means anything to it.
SLUG=$(git remote get-url origin | sed -E 's#\.git$##; s#.*[:/]([^/]+/[^/]+)$#\1#')

read -r HEAD_REF BASE_REF < <(
	gh pr view "$PR" --repo "$SLUG" \
		--json headRefName,baseRefName --jq '[.headRefName, .baseRefName] | @tsv'
)
[[ -n "${HEAD_REF:-}" && -n "${BASE_REF:-}" ]] || { echo "could not resolve refs for PR $PR" >&2; exit 1; }

# In stack mode the review is of the whole stack: the head reviewed is the
# top of the stack, the base is the default branch, both from stack-plan.
STACK_PLAN=""
if [[ "$STACK" == 1 ]]; then
	STACK_PLAN=$(mktemp -t hermes-stack-XXXXXX.json)
	if ! python3 "$BIN_DIR/stack-plan" --repo "$SLUG" --pr "$PR" >"$STACK_PLAN"; then
		rm -f "$STACK_PLAN"
		exit 2
	fi
	TOP_REF=$(jq -r '.top.head' "$STACK_PLAN")
	DEFAULT_REF=$(jq -r '.default_branch' "$STACK_PLAN")
	HEAD_REF="$TOP_REF"
	BASE_REF="$DEFAULT_REF"
fi

# Every ref the review and the attribution need. A stack is a set of branches,
# and a fetch that leaves one behind shows the review a tree that is not the
# stack's.
FETCH_REFS=("$HEAD_REF" "$BASE_REF")
if [[ "$STACK" == 1 ]]; then
	while IFS= read -r _ref; do
		[[ -n "$_ref" ]] && FETCH_REFS+=("$_ref")
	done < <(jq -r '.stack[] | .head, .base' "$STACK_PLAN")
fi

git fetch --quiet origin "${FETCH_REFS[@]}"

# The review's branch and worktree name the profile as well as the PR.
#
# Two profiles may review the same PR at the same time from one clone --
# that is how two reviewers' findings are compared -- and a branch named
# for the PR alone would collide. The worktree path names the profile for
# the same reason: one worktree holds the other reviewer's findings.
#
# The profile name was checked above, so it is one path and ref
# component as it is.
WT="$WT_ROOT/review-pr-$PR-$PROFILE"
BRANCH="review/pr-$PR-$PROFILE"
# The PR head the worktree was built from. By the review phase the worktree's
# HEAD is a readback or findings commit, and an ancestor check passes a head
# force-pushed back to an ancestor, so the review compares against this exactly.
# It is branch config, so `git branch -D` below drops it with the branch.
HEAD_KEY="branch.$BRANCH.hermesReviewHead"

# The readback phase rebuilds the worktree; the review phase inherits it, so the
# answers written between the two phases are reviewed against the same commit
# that produced the questions.
if [[ "$PHASE" == readback || ! -e "$WT" || -z "$(git config --get "$HEAD_KEY")" ]]; then
	[[ -e "$WT" ]] && git worktree remove --force "$WT"
	git branch -D "$BRANCH" >/dev/null 2>&1 || true
	git worktree add -b "$BRANCH" "$WT" "origin/$HEAD_REF" --quiet
	git config "$HEAD_KEY" "$(git rev-parse "origin/$HEAD_REF")"
elif [[ "$(git config --get "$HEAD_KEY")" != "$(git rev-parse "origin/$HEAD_REF")" ]]; then
	BUILT_SHA=$(git rev-parse --short "$(git config --get "$HEAD_KEY")")
	REMOTE_SHA=$(git rev-parse --short "origin/$HEAD_REF")
	echo "refusing to review stale source: worktree $WT was built from $BUILT_SHA but origin/$HEAD_REF is at $REMOTE_SHA" >&2
	echo "remove $WT (e.g. with 'git worktree remove --force $WT') and re-run, or re-run readback against the new head" >&2
	exit 1
fi

exec 8>&-

commit_artifact() { # path... subject
	local subject="${!#}"
	REVIEWED_SHA=$(git rev-parse --short "$(git config --get "$HEAD_KEY")")
	git -C "$WT" add -- "${@:1:$#-1}"
	git -C "$WT" -c user.name="hermes-review" -c user.email="hermes@localhost" \
		commit --quiet -m "$subject

$HEAD_REF at $REVIEWED_SHA, against $BASE_REF, with $PROFILE."
}

if [[ "$PHASE" == readback ]]; then
	acquire_review_slot "$PROFILE"
	DIFF=$(mktemp -t hermes-readback-XXXXXX.diff)
	git -C "$WT" diff "origin/$BASE_REF...origin/$HEAD_REF" >"$DIFF"
	# The readback goes to a file inside the worktree, so the agent's reply
	# is dropped into $WT/READBACK.md after the helper strips the
	# `session_id:` line that `chat -Q` writes first. The previous code
	# passed the prompt as one argv string (`-z`) and read the reply
	# straight off stdout; here the helper writes to $WT/READBACK.md.
	readback_prompt="You are about to review a proposed change to the repository at $WT. The diff is at $DIFF.

Do NOT review it yet. Do not write findings. Write a readback first, so the person who briefed you can correct the brief before you spend the review.

Read the diff and whatever source you need, then answer four things:

1. Scope: what you understand this change to be for, in your own words.
2. Checks: the specific checks you intend to run, and for each, what result would make you raise a finding.
3. Out of scope: what you will NOT report on, and why you believe it is out of scope.
4. Open questions: anything whose answer would change what you report, that you cannot settle from the repository alone.

Be concrete under 3 and 4. A vague readback is worse than none. Do not write to any file; reply with the readback itself."
	# The prompt file lives next to the worktree, in the directory
	# REVIEW_WT_ROOT the operator pointed at -- the sibling of every
	# review-pr-* it contains. Leaving the file behind the readback means
	# a post-mortem has the exact text that produced the answer, and the
	# path matches the shape of every other caller in this script.
	readback_dir=$(dirname "$WT")
	mkdir -p "$readback_dir"
	readback_prompt_file="$readback_dir/readback-$PR.prompt"
	printf '%s' "$readback_prompt" >"$readback_prompt_file"
	# Under set -e a failed hermes would exit here, before the message below.
	set +e
	timeout "$TIMEOUT" "$BASH" -c '
		. "$1/lib/common.sh"
		shift
		hermes_query "$@" 8>&- 9>&-
	' bash "$BIN_DIR/.." \
		"$HERMES -m hermes_cli.main" "$readback_prompt_file" \
		"$WT/READBACK.md" "$readback_dir/readback-$PR.stderr" \
		-p "$PROFILE" -- --yolo 9>&-
	RC=$?
	set -e
	exec 9>&-
	if [[ "$RC" -ne 0 ]]; then
		echo "hermes readback exited $RC (timeout was ${TIMEOUT}s)" >&2
		exit "$RC"
	fi
	commit_artifact READBACK.md "review(pr-$PR): readback before reviewing $HEAD_REF"
	echo "worktree: $WT"
	echo "readback: $WT/READBACK.md"
	echo "next:     answer its section 3 and 4, then --phase review --answers FILE"
	exit 0
fi

EXTRA=$(cat "$PRIORS")
if [[ -n "$ANSWERS" ]]; then
	[[ -r "$ANSWERS" ]] || { echo "answers file not readable: $ANSWERS" >&2; exit 2; }
	# Above the standing priors, because a decision made for this change
	# outranks a general prior it contradicts.
	EXTRA=$'DECISIONS FROM THE BRIEFING. These answer questions you raised, and they\noverride your own scope judgement where the two disagree.\n\n'"$(cat "$ANSWERS")"$'\n\n'"$EXTRA"
fi

# Forward only a --timeout the caller gave: a default would outrank the
# profile's own REVIEW_TIMEOUT_<PROFILE>.
SCRUTINIZE_ARGS=(--base "origin/$BASE_REF" --profile "$PROFILE" --extra "$EXTRA")
if [ -n "$TIMEOUT_PASSED" ]; then
	SCRUTINIZE_ARGS=(--timeout "$TIMEOUT_OPT" "${SCRUTINIZE_ARGS[@]}")
fi

FINDINGS=$(cd "$WT" && "$SCRUTINIZE" "${SCRUTINIZE_ARGS[@]}")

cp "$FINDINGS" "$WT/REVIEW_NOTES.md"

if [[ "$STACK" == 1 ]]; then
	# The attribution is computed against the worktree, the tree the reviewer
	# saw, over the plan the review was set up from: rediscovering the stack
	# here would attribute over whatever it changed into mid-review.
	ATTRIB=$(mktemp -t hermes-stack-attrib-XXXXXX.json)
	if ! python3 "$BIN_DIR/stack-attrib" \
		--plan "$STACK_PLAN" \
		--repo-path "$WT" \
		--findings "$FINDINGS" >"$ATTRIB"; then
		rm -f "$ATTRIB"
		echo "stack attribution failed" >&2
		exit 1
	fi
	cp "$ATTRIB" "$WT/STACK_ATTRIBUTION.json"
	rm -f "$ATTRIB"
	# The per-pull-request breakdown, so the operator sees which PR of the
	# stack each finding belongs to without reading the JSON.
	echo "stack:"
	jq -r '.stack[] | "  #\(.number) \(.head) -- \(.title)"' "$WT/STACK_ATTRIBUTION.json"
	echo "attribution:"
	jq -r '.findings[] | "  \(.path):\(.line) -> PR \(.pr // "stack") (\(.reason))"' \
		"$WT/STACK_ATTRIBUTION.json"
	echo "tally: $(jq -c '.tally' "$WT/STACK_ATTRIBUTION.json")"
	commit_artifact REVIEW_NOTES.md STACK_ATTRIBUTION.json \
		"review(pr-$PR): findings against $HEAD_REF, attributed across the stack"
else
	commit_artifact REVIEW_NOTES.md "review(pr-$PR): findings against $HEAD_REF"
fi

echo "worktree: $WT"
echo "branch:   $BRANCH (from origin/$HEAD_REF, not pushed)"
echo "findings: $WT/REVIEW_NOTES.md"
[[ "$STACK" == 1 ]] && echo "attribution: $WT/STACK_ATTRIBUTION.json"
exit 0
