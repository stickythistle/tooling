#!/usr/bin/env bash
# Hand a GitHub issue to the local Hermes agent's swe-updater skill.
#
# Hermes writes the change in a worktree this script does not create: the
# caller decides the branch point, so a failed run is thrown away by deleting
# the tree rather than by unwinding commits.
#
# Exit codes. 0 finished, 2 usage, 3 the lane identity would not pin, and
# 6 a previous attempt's agent would not let go of the session lease: the
# run stopped rather than resuming the session on top of a live writer.
# A SESSION_NOT_OWNED refusal that never clears is the other 6.
set -euo pipefail

# readlink -f: these are installed as symlinks into a bin directory on PATH,
# lane-watch and lib/ live beside the real file, and BASH_SOURCE holds the
# symlink's own path.
BIN_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source=../lib/common.sh
. "$BIN_DIR/../lib/common.sh"

HERMES=${HERMES_PYTHON:-${HERMES_HOME:-$HOME/.hermes}/hermes-agent/venv/bin/python}
TIMEOUT=${HERMES_IMPLEMENT_TIMEOUT:-5400}
# How long an attempt's agent gets to wind down after SIGTERM before the
# whole attempt group is SIGKILLed. Without this an agent that ignores
# SIGTERM (or a `bash -c` that will not exit while its foreground child is
# still running) keeps the session lease, and the next attempt's
# --continue is refused with SESSION_NOT_OWNED.
KILL_AFTER=${HERMES_IMPLEMENT_KILL_AFTER:-60}
# How long to wait, after an attempt is over, for its process group to
# empty before resuming the session. This is the window the refusal race
# lives in: the timed-out process can outlive `timeout` returning by a few
# seconds, and the lease is freed only once it is really gone.
SETTLE=${HERMES_IMPLEMENT_SETTLE:-120}

usage() {
	cat <<'EOF'
usage: hermes-implement --issue N --worktree PATH [--repo OWNER/NAME]
                        [--verify CMD] [--extra TEXT] [--profile NAME]

--profile selects the agent profile, which chooses both the model and the host.
Your profiles are your own; `issue-grade --lanes` names the same set, and the
three shapes worth having are:

  (omitted)  The quality lane, and what unspecified work gets: correcting a bad
             diff costs more than the extra minutes a careful model spends.
  fast       A quicker model for small or mechanical work, where latency
             matters more than judgement.
  small      A short-context host for extra-small work. Also the only way to
             run a second stream, since a host serving one request at a time
             makes two runs queue rather than overlap.

--verify defaults to `gate-verify <worktree>`, which picks its gates from the
diff rather than from whoever wrote the dispatch.

Prints the run's private directory on stdout. It holds the issue text, every
attempt's transcript and the lane's HANDOVER.md, and is the lane's TMPDIR.
EOF
}

# Empty means the root profile, which is the dense 27B quality lane.
ISSUE="" WORKTREE="" REPO="" EXTRA="" VERIFY="" PROFILE=""
while [[ $# -gt 0 ]]; do
	case "$1" in
	--issue) ISSUE="$2"; shift 2 ;;
	--worktree) WORKTREE="$2"; shift 2 ;;
	--repo) REPO="$2"; shift 2 ;;
	--verify) VERIFY="$2"; shift 2 ;;
	--extra) EXTRA="$2"; shift 2 ;;
	--profile) PROFILE="$2"; shift 2 ;;
	-h | --help) usage; exit 0 ;;
	*) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
	esac
done

# Chosen from the diff rather than by the caller. Picking a gate by hand is how
# a Helm template passed on Rust compiling and a misplaced --no-build reached
# CI: both times the gate was green and had not looked at the change.
: "${VERIFY:=gate-verify $WORKTREE}"

# -p rather than HERMES_PROFILE: the environment variable is read too late to
# pick the profile's model, so a run exported into it still talks to the default
# host.
PROFILE_ARGS=()
[[ -n "$PROFILE" ]] && PROFILE_ARGS=(-p "$PROFILE")
[[ -n "$ISSUE" && -n "$WORKTREE" ]] || { usage >&2; exit 2; }

cd "$WORKTREE"
# Canonical from here on. lane-settled finds this run's record by hashing
# `git rev-parse --show-toplevel`, so a caller passing a trailing slash or a
# relative path would otherwise write a record under a hash nothing reads.
WORKTREE=$(git rev-parse --show-toplevel)
BRANCH=$(git rev-parse --abbrev-ref HEAD)

# A private directory per run, exported as the lane's TMPDIR: a lane once ran
# `rm -rf` in the shared /tmp and deleted other sessions' files. -p, because
# -t would follow a TMPDIR the caller already set.
STATE_DIR=${AGENT_STATE_DIR:-$HOME/.local/state/agent-tools}
RUN_PARENT="$STATE_DIR/hermes-implement-runs"
mkdir -p "$RUN_PARENT"
WORK=$(mktemp -d -p "$RUN_PARENT" hermes-implement-XXXXXX)
export TMPDIR="$WORK" TMP="$WORK" TEMP="$WORK"
export_lane_build_env "$WORKTREE"


GH_ARGS=(issue view "$ISSUE")
[[ -n "$REPO" ]] && GH_ARGS+=(--repo "$REPO")
gh "${GH_ARGS[@]}" >"$WORK/issue.txt"

PROMPT=$(
	cat <<EOF
Implement one issue in the repository checked out at $WORKTREE.

Follow the swe-updater skill. The branch and worktree already exist: you are on
$BRANCH, based on the remote default branch. Skip the skill's ingest phase --
the work item is the issue below, not a REVIEW_NOTES.md file -- and do not
create, switch, or push any branch. Commit your work on $BRANCH and stop.

**Every file you write belongs to $WORKTREE.** Not only source files, and not
only git: nothing outside that directory is yours to change. Config files,
dotfiles, shared state, another worktree, anything under ~/.config or ~/.hermes
-- all off limits, even when changing one would make your task succeed. Other
work runs on this machine while you do, and a file outside your worktree is
something someone else is depending on right now. The one exception is
$WORK, this run's private directory, which is already your TMPDIR and is where
your HANDOVER.md goes.

**If a tool you need is broken, report it and stop. Do not repair it.** You may
be right about the cause: a previous run diagnosed a real bug in the
verification tooling correctly, wrote a workaround into a shared config file,
and carried on. That workaround changed the conditions of every other run on
this machine, hid the bug from the people who could fix it properly, and was
found days later by accident. A blocked task that reports why is a good
outcome. Put it in your handover and leave the environment as you found it.

That directory is also a git worktree of the same repository your project
settings point at, and it is not the same checkout. Editing the other one puts your
commit on a branch someone else is reading and leaves their checkout switched
underneath them. If a git command needs a repository, pass git's -C option and
this path. Do not cd elsewhere, and do not trust a remembered working directory
over this path.

The issue text is at $WORK/issue.txt. Read it in full before editing anything.

Verification command (the skill's Phase 4 -- run it yourself, read its output,
fix what it reports, and run it again until it passes):

    $VERIFY

$EXTRA

When you are done, write $WORK/HANDOVER.md: what you changed and why, what you
could not verify, and anything you deliberately left out.
EOF
)

BASE=$(git rev-parse HEAD)
BASE_SHORT=$(git rev-parse --short HEAD)
# Pin the lane identity before the agent starts. An honest agent
# inherits the env vars and commits as the expected identity; the
# verifier below is the backstop for one that overrides them. Refusing
# up front makes a missing setting a named error rather than a commit
# that points at nobody.
if ! export_lane_identity_env "$WORKTREE"; then
	exit 3
fi
# UTC, matching how hermes stamps last_edit_at, so the stray-write check below
# sees only this run.
START_ISO=$(date -u +%Y-%m-%dT%H:%M:%S)
ATTEMPTS=${HERMES_IMPLEMENT_ATTEMPTS:-4}

# Where hermes records what each session wrote. Resolved up front so the EXIT
# trap below can read the lane's last_edit_at without re-deriving the path on
# every code path that reaches it (a profile switch between attempts would
# otherwise move the file under the trap).
EVIDENCE_DB=${HERMES_HOME:-$HOME/.hermes}
[[ -n "$PROFILE" ]] && EVIDENCE_DB="$EVIDENCE_DB/profiles/$PROFILE"
EVIDENCE_DB="$EVIDENCE_DB/verification_evidence.db"

# Where this run's signals live: beside the worktree, in the state directory
# the other tools here already use. `lane-active` is the in-band marker that a hermes process holds
# the tree right now; `lane-final` is the record written at exit, naming the
# commit the lane left and the session's last_edit_at so a later check can
# tell drift from "the lane finished cleanly".
# A path cannot be a filename: it contains separators. The sha256 of the
# canonical path is stable across readers, which is what lets lane-settled
# find this record from the worktree alone.
WORKTREE_HASH=$(printf '%s' "$WORKTREE" | python3 -c "import hashlib,sys; print(hashlib.sha256(sys.stdin.read().encode()).hexdigest())")
ACTIVE_FILE="$STATE_DIR/lane-active/$WORKTREE_HASH"
FINAL_FILE="$STATE_DIR/lane-final/$WORKTREE_HASH"
# A sidecar index so a human can recover the path from the hash; the predicate
# itself only needs the hash to find the record.
mkdir -p "$STATE_DIR/lane-active" "$STATE_DIR/lane-final"
echo "$WORKTREE" >"$STATE_DIR/lane-active/$WORKTREE_HASH.path" 2>/dev/null || true
echo "$WORKTREE" >"$STATE_DIR/lane-final/$WORKTREE_HASH.path" 2>/dev/null || true
# Below the variables the trap reads. An EXIT trap installed before START_ISO
# and EVIDENCE_DB exist dies on the first failure it was meant to cover: under
# `set -u` it aborts unbound, writes no record, and leaves the active marker
# behind naming a pid that is gone.

# Record on every exit, including the failure paths. The signal that was always
# true -- the process ending -- is what we expose: the trap runs whether the
# lane committed, ran out of attempts, or was killed. `last_edit_at` is read
# fresh here so a resume that started before this trap was installed still
# carries the session's actual last edit, not START_ISO from a stale frame.
record_lane_final() {
	local final_tip last_edit now
	final_tip=$(git -C "$WORKTREE" rev-parse HEAD 2>/dev/null || echo "")
	last_edit="$START_ISO"
	if [[ -r "$EVIDENCE_DB" ]]; then
		last_edit=$(python3 - "$EVIDENCE_DB" "$WORKTREE" "$START_ISO" <<'PYEOF' 2>/dev/null || echo "$START_ISO"
import sqlite3, sys
db, root, since = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    c = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
    row = c.execute(
        "select max(last_edit_at) from verification_state"
        " where root = ? and last_edit_at >= ?", (root, since)).fetchone()
except sqlite3.Error:
    sys.exit(1)
print((row[0] if row and row[0] else since))
PYEOF
)
	fi
	now=$(date -u +%Y-%m-%dT%H:%M:%S)
	# Overwrite, not append: a previous run's record for this tree is by
	# definition stale -- the lane has run again, and the file should name
	# *this* run's exit, not the one before it.
	{
		echo "sha=$final_tip"
		echo "last_edit_at=$last_edit"
		echo "recorded_at=$now"
	} >"$FINAL_FILE"
	rm -f "$ACTIVE_FILE"
}
trap record_lane_final EXIT
echo "$$" >"$ACTIVE_FILE"

# A model that answers with prose instead of a tool call ends the run, so an
# abandoned task and a finished one both exit 0. The branch is the only
# trustworthy completion signal: keep resuming the session until it carries a
# commit that BASE did not.
#
# The attempt runs in the background and its process group is recorded in
# ATTEMPT_PGID, because the group is how `wait_attempt_gone` recognises
# "this attempt's processes are gone" before the next attempt resumes the
# session. `timeout` (GNU coreutils) puts itself in a fresh process group
# unless --foreground is given, so its pid is that group's id -- but the
# value is read back from /proc rather than assumed, and wait_attempt_gone
# refuses to signal a group that is this script's own.
ATTEMPT_PGID=""
run() {
	local label="$1" prompt="$2"
	shift 2
	set +e
	# --no-restore-cwd: a resumed session otherwise returns to the directory it
	# recorded, which for this agent is its bound project folder rather than the
	# worktree it was handed. It has committed in the wrong repository that way.
	# hermes inherits fd 8, the GPU group lock, which spans every retry.
	#
	# The prompt goes through a file in the run directory, never as argv:
	# `-z "$prompt"` cap'd at MAX_ARG_STRLEN (128 KiB), and a long brief with
	# `$(...)` or backticks survived shell interpretation badly. The file is
	# kept after the run, alongside the transcripts.
	local prompt_file="$WORK/$label.prompt"
	printf '%s' "$prompt" >"$prompt_file"
	# Heredoc-arr args: --skills lives after `chat`, --no-restore-cwd also,
	# and `--continue` (passed via "$@" by the retry loop) is what resumes an
	# earlier session. Pre-chat is `-p`. timeout wraps the whole call and the
	# subshell re-sources the helper so `hermes_query` is in scope; timeout
	# itself cannot call a parent's shell function directly.
	#
	# --kill-after is the backstop for the case KILL_AFTER's own comment
	# describes: without it `timeout` itself can hang, waiting on a
	# `bash -c` whose agent ignored SIGTERM. The kill-after path exits 137
	# rather than 124, reported as its own message below.
	PRE=("${PROFILE_ARGS[@]}")
	POST=(--skills "${HERMES_IMPLEMENT_SKILLS:-swe-updater,swe-tester}"
	      --yolo --no-restore-cwd "$@")
	timeout --kill-after="$KILL_AFTER" "$TIMEOUT" "$BASH" -c '
		. "$1/lib/common.sh"
		shift
		hermes_query "$@"
	' bash "$BIN_DIR/.." \
		"$HERMES -m hermes_cli.main" "$prompt_file" \
		"$WORK/$label.stdout" "$WORK/$label.stderr" \
		"${PRE[@]}" -- "${POST[@]}" &
	ATTEMPT_PID=$!
	ATTEMPT_PGID=$(attempt_pgid "$ATTEMPT_PID")
	wait "$ATTEMPT_PID"
	local rc=$?
	# A group that could not be established is not a reason to skip the
	# attempt, only a reason the settle wait cannot vouch for it. Say so
	# once here rather than in every caller of wait_attempt_gone.
	if [[ -z "$ATTEMPT_PGID" ]]; then
		echo "$label: cannot identify this attempt's process group;" \
			"the next attempt may resume on top of a live agent" >&2
	fi
	set -e
	if [[ "$rc" -eq 137 ]]; then
		echo "$label: hermes timed out (killed after ${KILL_AFTER}s grace)" >&2
	elif [[ "$rc" -eq 124 ]]; then
		echo "$label: hermes timed out" >&2
	else
		echo "$label: hermes exited $rc" >&2
	fi
	tail -3 "$WORK/$label.stdout" >&2
}

# The process group `timeout` put itself in, or nothing. Read from
# /proc/PID/stat field 3-after-comm (pgrp) rather than assumed to equal the
# pid: it does on GNU coreutils today, but the settle wait signals this
# group, and a wrong guess there kills processes nobody started. comm can
# contain spaces and parentheses, so the fields are read from after its
# last ')'.
#
# The read is retried: the child has just been forked and `timeout` calls
# setpgid after exec, so the first read can still see the parent's group.
# Returning the parent's group would be worse than returning nothing --
# the caller signals what it is given -- so a group equal to this script's
# own is treated as "not yet" and re-read.
attempt_pgid() {
	local pid="$1" stat rest pgid own deadline=$((SECONDS + 5))
	own=$(ps -o pgid= -p $$ | tr -d ' ')
	while (( SECONDS < deadline )); do
		stat=$(cat "/proc/$pid/stat" 2>/dev/null) || return 0
		rest=${stat##*') '}
		# shellcheck disable=SC2086 # deliberate split into fields
		set -- $rest
		pgid="${3:-}"
		# Still in this script's group (not yet re-grouped), or no value
		# yet: re-read. Anything else is the attempt's own group.
		[[ "$pgid" == "$own" ]] || { [[ "$pgid" =~ ^[0-9]+$ ]] && printf '%s\n' "$pgid"; return 0; }
		sleep 0.1
	done
	return 0
}

# Pids still alive in the attempt's group, one per line; empty when the
# group is empty or ATTEMPT_PGID was never established.
attempt_pids() {
	[[ -n "$ATTEMPT_PGID" ]] || return 0
	pgrep -g "$ATTEMPT_PGID" 2>/dev/null || true
}

# Block until the previous attempt's group is empty, so the session lease
# it holds is really free before the next attempt resumes the session.
# A group that is still occupied after the wait is SIGKILLed (this script
# started it) and waited on again; a group that survives that returns
# non-zero, because resuming on top of a live writer is worse than not
# finishing. The caller records the stop and the live-agent reason.
wait_attempt_gone() {
	local label="$1" deadline=$((SECONDS + SETTLE)) pids
	[[ -n "$ATTEMPT_PGID" ]] || return 0
	while :; do
		pids=$(attempt_pids)
		[[ -z "$pids" ]] && return 0
		(( SECONDS < deadline )) || break
		sleep 2
	done
	pids=$(attempt_pids)
	[[ -z "$pids" ]] && return 0
	echo "$label: previous attempt's agent (pids $(echo $pids | tr '\n' ' '))" \
		"still alive after ${SETTLE}s; killing" >&2
	# The group, not a name: another lane's hermes runs on this host and a
	# name match would kill it.
	kill -KILL -"$ATTEMPT_PGID" 2>/dev/null || true
	deadline=$((SECONDS + 10))
	while :; do
		pids=$(attempt_pids)
		[[ -z "$pids" ]] && return 0
		(( SECONDS < deadline )) || break
		sleep 1
	done
	echo "FAILED: $label's agent (pid $(echo "$pids" | head -1 | tr -d ' '))" \
		"would not exit; not resuming" >&2
	return 1
}

# Opt-in: a tmux window that follows this lane with lane-watch. hermes stays
# this script's child, and a window that cannot open never fails the lane.
if [[ -n "${LANE_WATCH_TMUX_SESSION:-}" ]] && command -v tmux >/dev/null 2>&1 &&
	tmux has-session -t "$LANE_WATCH_TMUX_SESSION" 2>/dev/null; then
	# --since: a fix round reuses the worktree, and the newest session there
	# is otherwise the previous lane's finished one.
	LANE_WATCH_ARGS=("$BIN_DIR/lane-watch" "$WORKTREE" --since "$(date -u +%s)")
	[[ -n "$PROFILE" ]] && LANE_WATCH_ARGS+=(--profile "$PROFILE")
	# Kept open after the lane ends, so its last messages stay readable.
	( tmux new-window -d -t "$LANE_WATCH_TMUX_SESSION" -n "$ISSUE" \
		"$(printf '%q ' "${LANE_WATCH_ARGS[@]}"); read -r _" ) >/dev/null 2>&1 || true
	unset LANE_WATCH_ARGS
fi

# Held across every attempt: retries are one run's worth of GPU work.
acquire_gpu_lock "$PROFILE"

# A run is finished when the worktree is clean and HANDOVER.md is
# non-empty. A 124 (or any other non-zero exit) falls through to the
# next iteration; the resume prompt is what tells that attempt
# where to pick up.
finished() {
	[[ -z "$(git -C "$WORKTREE" status --porcelain)" ]] \
		&& [[ -s "$WORK/HANDOVER.md" ]]
}

# hermes refuses `--continue` while another process still holds the
# session lease, naming the owner:
#
#   hermes-refusal-reason: SESSION_NOT_OWNED
#   Session <id> already has a live owner (cli, pid <n>, lease age <t>).
#
# That refusal is the run's own timing going wrong, not a failed attempt,
# so it must not spend one: the same attempt number is retried after the
# settle wait, up to REFUSALS times in a row. Any other outcome -- even
# another timeout -- resets the count.
REFUSALS=${HERMES_IMPLEMENT_REFUSALS:-3}
REFUSAL_REASON_RE='hermes-refusal-reason: SESSION_NOT_OWNED'
refusal_owner() { # <stderr file> -> "session <id> pid <n>"
	local f="$1" line session pid
	line=$(grep -m1 'already has a live owner' "$f" 2>/dev/null) || return 0
	session=$(sed -n 's/.*Session \([^ ]*\) already has.*/\1/p' <<<"$line")
	pid=$(sed -n 's/.*pid \([0-9]*\).*/\1/p' <<<"$line")
	[[ -n "$session" && -n "$pid" ]] || return 0
	printf 'session %s pid %s\n' "$session" "$pid"
}

# How the loop stops, for the tail after `done`. Both former `exit 6`
# sites now break out of the loop instead, so a run that gives up still
# runs the identity check, the summary and the stray-write report -- the
# same tail a finishing run runs.
# STOP_RC is the code that was about to be exited with; the run prints it
# at the very end. STOP_LIVE_AGENT marks the one stop reason that must
# skip the identity check: an attempt's agent is still alive and writing,
# and verify_lane_identity rebases the branch to re-author it.
STOP_RC="" STOP_LIVE_AGENT=""
i=1
refusals=0
while (( i <= ATTEMPTS )); do
	label="attempt$i"
	# Nothing from an earlier attempt may still be writing this worktree
	# before this one resumes the session. It runs before attempt 1 too,
	# where ATTEMPT_PGID is empty and it is a no-op.
	#
	# `if !`, not a bare call: under `set -e` a bare call would abort the
	# script from inside the loop, skipping the tail.
	if ! wait_attempt_gone "$label"; then
		STOP_RC=6
		STOP_LIVE_AGENT=1
		break
	fi
	if (( i == 1 )); then
		run "$label" "$PROMPT"
	else
		# The resume prompt names the current state (commits since
		# the base, uncommitted files, HANDOVER.md presence) so the
		# next attempt resumes the work that was outstanding, not
		# work it imagines. It must frame a clean tree as what
		# follows from finishing the work: framing it as the
		# deliverable invites `git checkout -- .` / `git stash` /
		# `git clean`, which `finished()` cannot tell from a tree
		# the lane actually finished.
		committed=$(git -C "$WORKTREE" log --oneline "$BASE"..HEAD 2>/dev/null \
			|| true)
		if [[ -z "$committed" ]]; then committed="(none)"; fi
		uncommitted=$(git -C "$WORKTREE" status --short 2>/dev/null \
			|| true)
		if [[ -z "$uncommitted" ]]; then uncommitted="(none)"; fi
		if [[ -s "$WORK/HANDOVER.md" ]]; then
			handover_state="present"
		else
			handover_state="missing"
		fi
		REMAINING=$(cat <<EOF
The task is not finished. Resume it with tool calls, not with a plan.

Base on $BRANCH was $BASE_SHORT. State now:
- Committed since base:
$committed
- Uncommitted files:
$uncommitted
- $WORK/HANDOVER.md: $handover_state

Finish each uncommitted change, verify it with '$VERIFY', and commit it
on $BRANCH. A change you cannot verify stays uncommitted and is named in
$WORK/HANDOVER.md. Never discard, stash, or reset work to make the tree
clean -- a clean tree is what follows from finishing the work, not the
goal in itself. The issue is #$ISSUE at $WORK/issue.txt.
$EXTRA

Follow the same brief the first attempt got.
EOF
)
		run "$label" "$REMAINING" --continue
	fi
	# A refusal does not spend an attempt. Retrying the same attempt
	# number is safe here because wait_attempt_gone at the top of the
	# loop waits for this attempt's own group to empty first, so the retry
	# cannot resume on top of the process that held the lease.
	if grep -qF "$REFUSAL_REASON_RE" "$WORK/$label.stderr" 2>/dev/null; then
		refusals=$((refusals + 1))
		if (( refusals >= REFUSALS )); then
			echo "FAILED: $(refusal_owner "$WORK/$label.stderr")" \
				"still owned after $refusals refusals" >&2
			# No STOP_LIVE_AGENT here: every refusal attempt's group
			# emptied before the next one ran, so nothing is writing
			# this worktree now and the identity check is safe.
			STOP_RC=6
			break
		fi
		echo "$label: refused (session still owned); retrying the same" \
			"attempt ($refusals/$REFUSALS)" >&2
		# `if !` for the same reason as the top-of-loop call above.
		if ! wait_attempt_gone "$label"; then
			STOP_RC=6
			STOP_LIVE_AGENT=1
			break
		fi
		sleep "$SETTLE"
		continue
	fi
	refusals=0
	finished && break
	i=$((i + 1))
done

exec 8>&-

# Re-author lane commits whose identity does not match the expected
# one, so a lane that overrode GIT_AUTHOR_* or used --author still
# pushes with the right identity. The exit code names the refusal
# (1 identity, 2 rewritten history, 3 base unresolved, 4 tree
# changed, 5 rebase failed).
#
# Skipped on the one stop reason where a live agent is still writing this
# worktree: re-authoring replays the lane's commits with a rebase, and
# rebasing under a live writer is how a tree gets half-rewritten. The
# commit is then reported as unverified rather than silently left as the
# agent wrote it. Every other stop reason -- including the refusal cap,
# where each attempt's group emptied before the next started -- verifies
# as usual.
IDENTITY_RC=0
if [[ -n "$STOP_LIVE_AGENT" ]]; then
	echo "IDENTITY: not verified (an attempt's agent is still running)" >&2
else
	verify_lane_identity "$WORKTREE" "$BASE" "$WORK/HANDOVER.md" || IDENTITY_RC=$?
fi

# Name the missing piece on a line of its own: stranded uncommitted
# files, a committed branch with no handover, a no-commit nothing-tried,
# or a lane the identity verifier refused.
DIRTY=$(git -C "$WORKTREE" status --porcelain 2>/dev/null || true)
HEAD=$(git -C "$WORKTREE" rev-parse HEAD 2>/dev/null || echo "")
if [[ -n "$DIRTY" ]]; then
	echo "FAILED: $ATTEMPTS attempts left $BRANCH with uncommitted files:" >&2
	printf '%s\n' "$DIRTY" >&2
elif [[ "$HEAD" == "$BASE" ]]; then
	echo "FAILED: $ATTEMPTS attempts left $BRANCH at $BASE_SHORT" >&2
elif [[ ! -s "$WORK/HANDOVER.md" ]]; then
	echo "WARNING: $BRANCH has a commit but no handover was written" >&2
elif [[ "$IDENTITY_RC" -ne 0 ]]; then
	# The verifier refused. Map its code to a one-line verdict next
	# to the other named outcomes; the same code list is in agent-fix-pr.
	case "$IDENTITY_RC" in
	1) echo "IDENTITY: refused (wrong author / committer on a lane commit)" >&2 ;;
	2) echo "IDENTITY: refused (lane rewrote the base out of ancestry)" >&2 ;;
	3) echo "IDENTITY: refused (base does not resolve in the worktree)" >&2 ;;
	4) echo "IDENTITY: refused (rebase changed the tree; old head restored)" >&2 ;;
	5) echo "IDENTITY: refused (rebase could not start)" >&2 ;;
	*) echo "IDENTITY: refused (verifier rc=$IDENTITY_RC)" >&2 ;;
	esac
fi

# What the run actually wrote, which the handover is not a complete account of:
# one lane created and deleted a scratch file its handover never mentioned, and
# another edited a shared config file while reporting only its issue. hermes
# records every edited path per session here, so this is the only place the
# question can be answered after the fact.
if [[ -r "$EVIDENCE_DB" ]]; then
	python3 - "$EVIDENCE_DB" "$WORKTREE" "$START_ISO" "$WORK" <<'PYEOF' >&2 || true
import json, sqlite3, sys
db, worktree, since = sys.argv[1], sys.argv[2].rstrip("/"), sys.argv[3]
# The run's own directory is where this script tells the lane to put its
# handover, so a write there is the instruction being followed. Flagging it
# trains the reader to skip the warning, which costs the real ones.
work = sys.argv[4].rstrip("/")
try:
    c = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
    rows = c.execute(
        "select session_id, changed_paths_json from verification_state"
        " where root = ? and last_edit_at >= ?", (worktree, since)).fetchall()
except sqlite3.Error:
    sys.exit(0)
stray = sorted({p for _, j in rows for p in json.loads(j or "[]")
                if not p.startswith(worktree + "/")
                and not p.startswith(work + "/")})
if stray:
    print(f"WARNING: this run wrote {len(stray)} path(s) outside {worktree}:")
    for p in stray:
        print(f"  {p}")
    print("  A lane may only write inside its worktree. Review before trusting"
          " this run, and before trusting anything else that reads those paths.")
PYEOF
fi

# Kept after every run: callers read HANDOVER.md, or the transcripts on failure.
echo "$WORK"

# The code the loop's break was going to exit with, now that everything
# above it has run: 6 for a lease that would not free, 0 for a run that
# finished or that used up its attempts. Last, so it overrides the exit
# status of the report above it without skipping any of it.
exit "${STOP_RC:-0}"
