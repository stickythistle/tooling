#!/usr/bin/env python3
"""Ask the lane keeper for the lane state, so two sessions cannot both take a lane.

    lane spawn --repo R --issue N --harness H --profile P
    lane spawn --repo R --issue N --harness H --profile P --queue --brief PATH
    lane list [--json]
    lane dispatch
    lane dequeue REQUEST
    lane resume LEASE
    lane check LEASE
    lane release LEASE
    lane finish LEASE
    lane finish --merged
    lane finish --abandon LEASE
    lane report

A refusal exits 1 and names what refused.

`--queue` waits for a unit when the pool is full; `--brief` names a
brief on the agent host.

`lane report` runs on the agent host, where the windows are.
"""
from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from lane import main  # noqa: E402


if __name__ == "__main__":
    sys.exit(main())
