#!/usr/bin/env bash
# Refuse four pushes that would land on the remote in a shape nobody
# intended:
#
#   1. a push that deletes files main added after the branch's previous
#      push -- a squash that resets onto a moved origin/main records
#      main's new files as deletions, and nothing before push sees that;
#   2. a push whose base moved backwards -- the branch is now rooted on
#      an older main than the push it replaces;
#   3. a push whose range carries a copy of a commit main already has
#      -- same patch, new sha.
#   4. a push whose commits carry a secret -- the secret leaves the
#      host, and a PR head stays reachable after a force-push;

# A PR created ready never meets pr-ready, so this check has to run on
# every push: install with
#   git config core.hooksPath /path/to/agent-tools/hooks
# PUSH_GUARD_BASE picks the branch to check against (default main);
# PUSH_GUARD_ACK=1 turns the three shape refusals into warnings;
# PUSH_GUARD_GITLEAKS names the scanner, else gitleaks on PATH, else
# the pinned installer's prefix under $HOME. A missing scanner refuses
# the push: the commits go unscanned.

# The secret check runs on every ref the push carries, the base branch
# and tags included. PUSH_GUARD_ACK stops at it: a false positive is
# fixed in the repository's .gitleaks.toml, where review sees it.

# The scan reads its allowlist and its ignore list from the pushed
# commit: an untracked .gitleaks.toml or .gitleaksignore, or one in the
# environment, cannot silence it.
set -euo pipefail

REMOTE=${1:-}
BASE_BRANCH=${PUSH_GUARD_BASE:-main}
# The recovery this prints names $REMOTE/$BASE_BRANCH, not the local
# branch: the guard judges against the remote-tracking ref, and a lane
# worktree's local branch is often stale or missing entirely. Following
# advice that named the local branch would rebase onto old history --
# the very thing the base-regression check refuses.
BASE_REF=$REMOTE/$BASE_BRANCH

note() { echo "push-guard: $*" >&2; }

if [ -z "$REMOTE" ]; then
	note "missing remote name (first arg); skipping"
	exit 0
fi

BASE=refs/remotes/$REMOTE/$BASE_BRANCH

# The three shape checks judge a branch against the base and need a
# tracking ref; the secret scan judges the commits the push carries and
# needs none.
HAVE_BASE=0
if git rev-parse --verify --quiet "$BASE" >/dev/null; then
	HAVE_BASE=1
else
	note "no local tracking ref for $BASE; skipping the shape checks"
fi

ZERO=0000000000000000000000000000000000000000
FAIL=0
ANY_REF=0

# ---- The secret scan ------------------------------------------------------
#
# The pin is the one place the gitleaks version is written down: the
# installer reads it and this guard reads it, so a binary of another
# version is refused.
GUARD_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
PIN_FILE="$GUARD_DIR/../install/gitleaks/pin"
GITLEAKS_BIN=""
GITLEAKS_STATE=unknown
REPORT=$(mktemp "${TMPDIR:-/tmp}/push-guard-gitleaks.XXXXXX") || {
	note "could not create a report file; the push would go unscanned."
	exit 1
}
# The config gitleaks reads is written here, out of the pushed commit.
CONFIG_FILE=$(mktemp "${TMPDIR:-/tmp}/push-guard-gitleaks-config.XXXXXX") || {
	note "could not create a config file; the push would go unscanned."
	exit 1
}
# The ignore list gitleaks reads is written here, for the same reason.
IGNORE_FILE=$(mktemp "${TMPDIR:-/tmp}/push-guard-gitleaks-ignore.XXXXXX") || {
	note "could not create an ignore file; the push would go unscanned."
	exit 1
}
trap 'rm -f "$REPORT" "$CONFIG_FILE" "$IGNORE_FILE"' EXIT

# The pinned version, read from the pin file.
pinned_version() {
	[ -f "$PIN_FILE" ] || return 1
	sed -n 's/^version=//p' "$PIN_FILE" | head -1
}

# The pinned installer's prefix, read from the pin file.
pinned_prefix() {
	[ -f "$PIN_FILE" ] || return 1
	sed -n 's/^prefix=//p' "$PIN_FILE" | head -1
}

# Where the pinned installer puts the scanner, under this HOME.
pinned_scanner() {
	local prefix
	prefix=$(pinned_prefix) || return 1
	[ -n "$prefix" ] || return 1
	printf '%s\n' "${prefix//\$HOME/${HOME:-}}/gitleaks"
}

# The scanner to run: the one named, else gitleaks on PATH, else the
# pinned installer's prefix under $HOME. A lane's PATH may lack
# ~/.local/bin.
gitleaks_binary() {
	if [ -n "${PUSH_GUARD_GITLEAKS:-}" ]; then
		printf '%s\n' "$PUSH_GUARD_GITLEAKS"
		return 0
	fi
	if command -v gitleaks >/dev/null 2>&1; then
		printf '%s\n' gitleaks
		return 0
	fi
	local fallback
	fallback=$(pinned_scanner) || return 1
	[ -x "$fallback" ] || return 1
	printf '%s\n' "$fallback"
}

# Whether the scanner is the pinned one. Memoised: a push with several
# refs says the problem once.
gitleaks_ready() {
	[ "$GITLEAKS_STATE" = ready ] && return 0
	[ "$GITLEAKS_STATE" = broken ] && return 1
	GITLEAKS_STATE=broken

	if [ -z "$GITLEAKS_BIN" ]; then
		GITLEAKS_BIN=$(gitleaks_binary || true)
	fi
	if [ -z "$GITLEAKS_BIN" ]; then
		fallback=$(pinned_scanner || true)
		[ -n "$fallback" ] || fallback="the prefix in $PIN_FILE"
		note "gitleaks is not installed: not on PATH, and not at $fallback; a push scanned without it would carry secrets off this host."
		note "install the pinned version with install/gitleaks/install.sh, or point PUSH_GUARD_GITLEAKS at it."
		return 1
	fi

	if ! command -v "$GITLEAKS_BIN" >/dev/null 2>&1; then
		note "gitleaks is not installed ($GITLEAKS_BIN not found); a push scanned without it would carry secrets off this host."
		note "install the pinned version with install/gitleaks/install.sh, or point PUSH_GUARD_GITLEAKS at it."
		return 1
	fi

	pinned=$(pinned_version || true)
	if [ -z "$pinned" ]; then
		note "no pinned gitleaks version in $PIN_FILE; install/gitleaks/install.sh reads it from there."
		return 1
	fi

	found=$("$GITLEAKS_BIN" version 2>/dev/null || true)
	found=$(printf '%s' "$found" | tr -d '[:space:]')
	if [ -z "$found" ]; then
		note "gitleaks did not report a version; the pinned version is $pinned."
		note "install the pinned version with install/gitleaks/install.sh."
		return 1
	fi
	if [ "$found" != "$pinned" ]; then
		note "gitleaks is $found, but the pinned version is $pinned."
		note "install the pinned version with install/gitleaks/install.sh."
		return 1
	fi

	GITLEAKS_STATE=ready
	return 0
}

# One line per finding: <rule> <file>:<line> <commit>. The value that
# matched is never printed: the lane's output is logged.
gitleaks_findings() {
	python3 - "$1" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8", errors="replace") as report:
        findings = json.load(report)
except Exception:
    sys.exit(1)
for finding in findings:
    print("%s %s:%s %s" % (finding.get("RuleID", "?"),
                           finding.get("File", "?"),
                           finding.get("StartLine", "?"),
                           str(finding.get("Commit", ""))[:12]))
PY
}

# The pushed range: the commits the remote is missing, so a secret
# added in one commit and removed in the next is still in it.
scan_commits_for_secrets() {
	local local_sha=$1 remote_sha=$2 remote_ref=$3
	local log_opts resolved findings scan_dir rc=0 parse_rc=0

	gitleaks_ready || return 1

	if ! resolved=$(git rev-parse --verify --quiet "$local_sha^{commit}"); then
		note "$remote_ref: commit $local_sha is not in the local object store; cannot scan what it carries."
		return 1
	fi

	# The allowlist is the one in the pushed commit. A file in the
	# working tree, or in the environment, silences a scan nobody
	# reviewed, so the config is written here and the environment's
	# own config names are cleared.
	if git show "$resolved:.gitleaks.toml" >"$CONFIG_FILE" 2>/dev/null; then
		:
	else
		printf '[extend]\nuseDefault = true\n' >"$CONFIG_FILE"
	fi

	# The ignore list comes from the pushed commit the same way.
	if git show "$resolved:.gitleaksignore" >"$IGNORE_FILE" 2>/dev/null; then
		:
	else
		: >"$IGNORE_FILE"
	fi

	# The source moves as well: gitleaks reads {source}/.gitleaksignore on
	# top of --gitleaks-ignore-path, and {source} is the working tree. The
	# object store gives up the same `git log -p` diff with no lane file
	# beside it.
	if ! scan_dir=$(git rev-parse --absolute-git-dir 2>/dev/null); then
		note "$remote_ref: cannot locate the object store to scan; refusing rather than scanning the working tree."
		return 1
	fi

	if [ "$remote_sha" = "$ZERO" ]; then
		log_opts="$resolved --not --remotes=$REMOTE"
	elif git rev-parse --verify --quiet "$remote_sha^{commit}" >/dev/null; then
		log_opts="$remote_sha..$resolved"
	else
		note "$remote_ref: the remote's sha $remote_sha is not in the local object store; scanning every commit not on $REMOTE instead."
		log_opts="$resolved --not --remotes=$REMOTE"
	fi

	env -u GITLEAKS_CONFIG -u GITLEAKS_CONFIG_TOML \
		"$GITLEAKS_BIN" git --log-opts="$log_opts" --redact --no-banner \
		--exit-code 3 --report-format json --report-path "$REPORT" \
		--config "$CONFIG_FILE" --gitleaks-ignore-path "$IGNORE_FILE" \
		"$scan_dir" >/dev/null 2>&1 || rc=$?

	case "$rc" in
	0)
		return 0
		;;
	3)
		findings=$(gitleaks_findings "$REPORT") || parse_rc=$?
		if [ "$parse_rc" -ne 0 ] || [ -z "$findings" ]; then
			note "$remote_ref: gitleaks reported a secret but the report could not be read."
			return 1
		fi
		note "$remote_ref carries a secret:"
		while IFS= read -r finding; do
			printf '  %s\n' "$finding" >&2
		done <<<"$findings"
		note "the push would carry it off this host; remove it from the commit, or allowlist the file in the repository's .gitleaks.toml."
		return 1
		;;
	*)
		note "gitleaks failed (exit $rc) scanning the commits $remote_ref carries; refusing the push rather than letting it through unscanned."
		return 1
		;;
	esac
}

# Each line on stdin: <local_ref> <local_sha> <remote_ref> <remote_sha>
while read -r local_ref local_sha remote_ref remote_sha; do
	# Tolerate blank or whitespace-only lines without tripping set -e.
	[ -z "${local_ref:-}" ] && continue
	ANY_REF=1

	# Skip ref deletions: local sha is all zeros.
	if [ "$local_sha" = "$ZERO" ]; then
		continue
	fi

	# ---- Check: the commits this push carries hold no secret ---------
	#
	# Before the shape checks, and on every ref the push carries: the
	# base branch and tags included, because a secret on main leaks
	# the same way.
	if ! scan_commits_for_secrets "$local_sha" "$remote_sha" "$remote_ref"; then
		FAIL=1
	fi

	# The shape checks below judge a branch against the base.
	if [ "$HAVE_BASE" -eq 0 ]; then
		continue
	fi

	# By destination: local_ref can be `HEAD` or a bare SHA
	# (`git push origin HEAD:feat`), while remote_ref is always the branch.
	case "$remote_ref" in
	refs/heads/*) ;;
	*) continue ;;
	esac

	# The base branch deleting its own earlier files is history, not a
	# clobber from a stale branch.
	if [ "$remote_ref" = "refs/heads/$BASE_BRANCH" ]; then
		continue
	fi

	local_sha=$(git rev-parse --verify "$local_sha^{commit}")
	base_sha=$(git rev-parse --verify "$BASE")

	if ! merge_base=$(git merge-base "$base_sha" "$local_sha"); then
		note "$remote_ref: no common ancestor with $BASE; skipping"
		continue
	fi

	# ---- Check: patch already on base -------------------------------
	#
	# `git cherry BASE local` walks the pushed range (merge_base..local)
	# and marks each commit '-' when its patch is already on BASE under
	# another sha. That is the shape a mid-run rebase plus the identity
	# verifier's re-author leaves behind: same patch, new sha, and a
	# later merge would put main's history on the PR twice.
	#
	# This runs for new branches too: a branch that never pushed can
	# still carry a duplicate, and there is no previous push to compare
	# it against.
	#
	# `git cherry` prints the branch-side sha; the twin on BASE is
	# found by patch-id, which is what `git cherry` itself matches on.
	dup_commit=
	dup_subject=
	while read -r mark sha subject; do
		if [ "$mark" = "-" ]; then
			dup_commit=$sha
			dup_subject=$subject
			break
		fi
	done < <(git cherry -v "$base_sha" "$local_sha" 2>/dev/null || true)

	if [ -n "$dup_commit" ]; then
		dup_patch_id=$(git show "$dup_commit" | git patch-id --stable | cut -d' ' -f1)
		twin=
		if [ -n "$dup_patch_id" ]; then
			while read -r pid sha; do
				if [ "$pid" = "$dup_patch_id" ]; then
					twin=$sha
					break
				fi
			done < <(git log -p --pretty=format:'%H' "$base_sha" | git patch-id --stable)
		fi

		note "$remote_ref carries a patch that $BASE_BRANCH already has:"
		note "  branch commit: $dup_commit $dup_subject"
		if [ -n "$twin" ]; then
			note "  same patch on $BASE_BRANCH: $twin"
		fi
		note "the push would land a second copy of $BASE_BRANCH's change under a new sha."
		if [ "${PUSH_GUARD_ACK:-0}" = "1" ]; then
			note "PUSH_GUARD_ACK=1: acknowledging and pushing anyway."
		else
			note "acknowledge by re-running with PUSH_GUARD_ACK=1, or fetch the base and rebase onto it (git fetch $REMOTE && git rebase $BASE_REF), which drops the commit whose patch is already upstream, then rebuild with squash (squash -F <msg-file>)."
			FAIL=1
		fi
	fi

	# The checks below compare against the branch's previous push, so a
	# new branch has nothing to compare against.
	if [ "$remote_sha" = "$ZERO" ]; then
		continue
	fi

	# The remote's last-pushed sha may not be in the local object
	# store yet (the working checkout never fetched it). When that
	# happens we cannot compute gained; silently passing is worse
	# than saying so.
	if ! git rev-parse --verify --quiet "$remote_sha^{commit}" >/dev/null; then
		note "$remote_ref: remote sha $remote_sha not found locally; fetching would let the check run"
		continue
	fi

	remote_sha=$(git rev-parse --verify "$remote_sha^{commit}")

	# ---- Check: the base moved backwards ----------------------------
	#
	# The branch's previous push sat on a newer main than this push
	# does. `git reset --soft origin/main` followed by
	# `git commit --amend` rewrites main's tip commit instead of
	# adding one, so the rebuilt commit is parented on main's
	# *previous* commit. Nothing deletes anything, so the gained/deleted
	# check above stays silent on it.
	#
	# old is where the branch forked for the push being replaced, new is
	# where it forks now. new strictly older than old is a regression:
	# moving forward (a rebase onto newer main) is intended and allowed.
	#
	# Main need not have moved at all for this to happen: the branch can
	# be re-rooted on an older main commit than the one it was pushed
	# on, and the push is what would carry that back.
	old_base=$(git merge-base "$base_sha" "$remote_sha" 2>/dev/null || true)
	new_base=$(git merge-base "$base_sha" "$local_sha" 2>/dev/null || true)
	if [ -n "$old_base" ] && [ -n "$new_base" ] && [ "$new_base" != "$old_base" ] \
		&& git merge-base --is-ancestor "$new_base" "$old_base"; then
		note "$remote_ref would move the branch's base backwards:"
		note "  base at the previous push: $old_base"
		note "  base at this push:        $new_base"
		note "the branch now forks from an older $BASE_BRANCH commit than the push it replaces did."
		if [ "${PUSH_GUARD_ACK:-0}" = "1" ]; then
			note "PUSH_GUARD_ACK=1: acknowledging and pushing anyway."
		else
			note "acknowledge by re-running with PUSH_GUARD_ACK=1, or fetch the base and rebase onto it (git fetch $REMOTE && git rebase $BASE_REF), where the three-way merge treats $BASE_BRANCH's change as already applied, then rebuild with squash (squash -F <msg-file>)."
			FAIL=1
		fi
	fi

	deleted=$(git diff --name-only --diff-filter=D "$merge_base" "$local_sha")
	# gained: paths main added between the branch's previously pushed
	# head and base. This is what a stale-base squash would clobber.
	gained=$(git log --format= --name-only --diff-filter=A "$remote_sha".."$base_sha")

	if [ -z "$deleted" ] || [ -z "$gained" ]; then
		continue
	fi

	# sort | uniq -d over the two lists joined would report a path
	# merely repeated inside one list; dedupe each side first.
	deleted=$(printf '%s\n' "$deleted" | sort -u)
	gained=$(printf '%s\n' "$gained" | sort -u)
	# Intersection via comm, available everywhere git ships.
	intersection=$(comm -12 <(printf '%s\n' "$deleted") \
		<(printf '%s\n' "$gained"))
	if [ -z "$intersection" ]; then
		continue
	fi

	note "$remote_ref would delete paths main added after the branch's last push:"
	while IFS= read -r path; do
		printf '  %s\n' "$path" >&2
	done <<< "$intersection"
	note "main added these commits after the branch's previous push; the push would re-delete them."
	if [ "${PUSH_GUARD_ACK:-0}" = "1" ]; then
		note "PUSH_GUARD_ACK=1: acknowledging and pushing anyway."
	else
		note "acknowledge by re-running with PUSH_GUARD_ACK=1, or rebase the branch onto the current $BASE_BRANCH."
		FAIL=1
	fi
done

[ "$ANY_REF" -eq 1 ] || exit 0
exit "$FAIL"
